#!/bin/sh
#
# Refresh the strategy narrative and write the snapshot that the other machine reads.
# Run from anywhere; no RStudio needed:
#
#   ./bin/refresh-narrative
#
# The working directory is set to the project root first, because .Rprofile derives
# the project root from it and activates renv from there.

set -e

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

if ! command -v Rscript >/dev/null 2>&1; then
  echo "Rscript is not on PATH. Install R, or open the project in RStudio and run export_strategy_narrative()." >&2
  exit 1
fi

exec Rscript "$root/tools/export-narrative.R" "$@"
